[Unit]
Description=Vikunja
After=traefik.service infisical-agent.service autorestic-restore.service
Wants=autorestic-restore.service
ConditionPathExists=/opt/secrets/vikunja.env
ConditionPathExists=/opt/secrets/vikunja-postgres.env

[Service]
Type=oneshot
WorkingDirectory=/opt/containers/vikunja
ExecStart=/usr/bin/podman compose --env-file /opt/env/vikunja.env up -d
ExecStop=/usr/bin/podman compose --env-file /opt/env/vikunja.env stop vikunja
ExecStop=/usr/bin/podman compose --env-file /opt/env/vikunja.env exec -T postgres pg_dump -U vikunja -d vikunja --no-owner -f /srv/postgres/vikunja.pgsql.tmp
ExecStop=/usr/bin/podman compose --env-file /opt/env/vikunja.env exec -T postgres mv /srv/postgres/vikunja.pgsql.tmp /srv/postgres/vikunja.pgsql
ExecStop=/usr/bin/podman compose down
ExecStopPost=-/usr/bin/podman compose down --remove-orphans
RemainAfterExit=yes

[Install]
WantedBy=secret@vikunja.env.service secret@vikunja-postgres.env.service
