[Unit]
Description=Vikunja
After=traefik.service infisical-agent.service autorestic-restore.service
Wants=autorestic-restore.service
ConditionPathExists=/opt/secrets/vikunja.env
ConditionPathExists=/opt/secrets/vikunja-postgres.env

[Service]
Type=oneshot
WorkingDirectory=/opt/containers/vikunja
ExecStart=/usr/bin/podman compose --env-file /opt/env/vikunja.env up -d
ExecStop=/usr/bin/podman compose down
ExecStopPost=-/usr/bin/podman compose down --remove-orphans
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
