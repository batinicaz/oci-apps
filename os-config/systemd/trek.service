[Unit]
Description=Trek
After=traefik.service infisical-agent.service autorestic-restore.service
Wants=autorestic-restore.service
ConditionPathExists=/opt/secrets/trek.env

[Service]
Type=oneshot
WorkingDirectory=/opt/containers/trek
ExecStart=/usr/bin/podman compose --env-file /opt/env/trek.env up -d
ExecStop=/usr/bin/podman compose down
ExecStopPost=-/usr/bin/podman compose down --remove-orphans
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
